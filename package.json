{
  "name": "golden-nest",
  "private": true,
  "version": "0.1.0",
  "description": "Golden Nest monorepo",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm --workspace @golden-nest/web run dev --",
    "build": "npm --workspace @golden-nest/web run build",
    "start": "npm --workspace @golden-nest/web run start"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@10.8.2"
}
